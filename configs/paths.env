# WSI storage layout (as of 2026-04-22)
# Cold/bulk storage (NFS-backed, 7.4 TB): raw WSI cohorts
export WSI_ROOT=/mnt/nas1/wsi_datasets
export WSI_TCGA_DIR=/mnt/nas1/wsi_datasets/tcga
export WSI_C16_DIR=/mnt/nas1/wsi_datasets/camelyon16
export WSI_EXTERNAL_DIR=/mnt/nas1/wsi_datasets/external
# Hot cache (local SSD, 1.9 TB): HDF5 patches, teacher features
export WSI_CACHE_DIR=/data3/cache
export WSI_PATCH_CACHE=/data3/cache/patches
export WSI_FEATURE_CACHE=/data3/cache/features
# Project dir
export WSI_PROJ=/home/holiday/wsi_hl
